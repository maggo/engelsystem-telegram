msgstr "Bot"

msgid "telegram.admin.checkin.title"
msgstr "Today's check-in QR code"

msgid "telegram.dashboard.title"
msgstr "Volunteer dashboard"

msgid "telegram.admin.onboarding.title"
msgstr "Onboarding codes"

msgid "config.telegram"
msgstr "Telegram"

msgid "config.telegram_bot_token"
msgstr "Bot token"

msgid "config.telegram_bot_token.info"
msgstr "From @BotFather. Changing it also changes the webhook secret and the pinger URL: reconnect the bot and update the pinger afterwards."

msgid "config.telegram_client_id"
msgstr "Login client ID"

msgid "config.telegram_client_secret"
msgstr "Login client secret"

msgid "config.telegram_client_id.info"
msgstr "From @BotFather > your bot > Login Widget. Both fields are needed for login with Telegram."

msgid "config.telegram_standby_area"
msgstr "Standby area"

msgid "config.telegram_standby_area.info"
msgstr "Name of the area (angel type) whose volunteers wait on standby shifts. Standby shifts must be shifts of their own. Replacements for any area then come only from the people on standby at that time; picking one moves them off standby. Its open slots are not reported as gaps. Leave empty if there is no standby."

msgid "config.telegram_meeting_place"
msgstr "Meeting place"

msgid "config.telegram_meeting_place.info"
msgstr "Where volunteers meet before their shift, e.g. \"the volunteer lounge\". The shift reminder asks them to be there an hour before the shift starts. Leave empty to just give the time."

msgid "telegram.admin.unlink.title"
msgstr "Set or reset a Telegram link"

msgid "telegram.admin.unlink.info"
msgstr "For someone you created in Engelsystem, a wrong handle, or when the wrong person connected: removes the account's bot chat and Telegram login (if any) and logs them out. Afterwards the account waits for the Telegram username you enter, or its Engelsystem username if left empty, and connects when that username messages the bot. Optional: people can also log in and connect Telegram under Settings > OAuth."

msgid "telegram.admin.unlink"
msgstr "Set link"
