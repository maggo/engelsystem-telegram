{
    "type": "engelsystem-plugin",
    "name": "telegram/plugin",
    "description": "Telegram login, onboarding, check-in and a shift bot for volunteers",
    "version": "1.3.0",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/maggo/engelsystem-telegram",
    "extra": {
        "config_options": {
            "telegram": {
                "icon": "telegram",
                "order": 70,
                "config": {
                    "telegram_bot_token": {
                        "type": "password"
                    },
                    "telegram_client_id": {
                        "type": "string"
                    },
                    "telegram_client_secret": {
                        "type": "password"
                    },
                    "telegram_standby_area": {
                        "type": "string"
                    },
                    "telegram_meeting_place": {
                        "type": "string"
                    }
                }
            }
        },
        "event_handlers": {
            "news.created": "Telegram\\Plugin\\NewsNotification@created"
        },
        "providers": [
            "Telegram\\Plugin\\ServiceProvider"
        ],
        "middleware": [
            "Telegram\\Plugin\\OAuthMiddleware",
            "Telegram\\Plugin\\TickMiddleware"
        ],
        "routes": {
            "/admin/telegram": "Telegram\\Plugin\\AdminController@index",
            "/admin/telegram/dashboard": "Telegram\\Plugin\\AdminController@dashboard",
            "/admin/telegram/dashboard.js": "Telegram\\Plugin\\AdminController@dashboardScript",
            "/admin/telegram/live": "Telegram\\Plugin\\AdminController@live",
            "/admin/telegram/live.js": "Telegram\\Plugin\\AdminController@liveScript",
            "/admin/telegram/overview": "Telegram\\Plugin\\AdminController@overview",
            "/admin/telegram/overview.js": "Telegram\\Plugin\\AdminController@overviewScript",
            "/admin/telegram/checkins": "Telegram\\Plugin\\AdminController@checkins",
            "/admin/telegram/checkins.js": "Telegram\\Plugin\\AdminController@checkinsScript",
            "/admin/telegram/checkins/set": [
                "Telegram\\Plugin\\AdminController@checkinsSet",
                "POST"
            ],
            "/admin/telegram/checkins/leads": [
                "Telegram\\Plugin\\AdminController@checkinsLeads",
                "POST"
            ],
            "/admin/telegram/attendance": "Telegram\\Plugin\\AdminController@attendance",
            "/admin/telegram/swap": "Telegram\\Plugin\\AdminController@swap",
            "/admin/telegram/swap.js": "Telegram\\Plugin\\AdminController@swapScript",
            "/admin/telegram/swap/move": [
                "Telegram\\Plugin\\AdminController@swapMove",
                "POST"
            ],
            "/admin/telegram/standby": "Telegram\\Plugin\\AdminController@standby",
            "/admin/telegram/standby.js": "Telegram\\Plugin\\AdminController@standbyScript",
            "/admin/telegram/standby/move": [
                "Telegram\\Plugin\\AdminController@standbyMove",
                "POST"
            ],
            "/admin/telegram/needs": "Telegram\\Plugin\\AdminController@needs",
            "/admin/telegram/needs.js": "Telegram\\Plugin\\AdminController@needsScript",
            "/admin/telegram/needs/save": [
                "Telegram\\Plugin\\AdminController@needsSave",
                "POST"
            ],
            "/admin/telegram/import": [
                "Telegram\\Plugin\\AdminController@import",
                "POST"
            ],
            "/admin/telegram/import-shifts": [
                "Telegram\\Plugin\\AdminController@importShifts",
                "POST"
            ],
            "/admin/telegram/unlink": [
                "Telegram\\Plugin\\AdminController@unlink",
                "POST"
            ],
            "/admin/telegram/bot": [
                "Telegram\\Plugin\\AdminController@bot",
                "POST"
            ],
            "/admin/telegram/qr": "Telegram\\Plugin\\AdminController@qr",
            "/telegram/webhook": [
                "Telegram\\Plugin\\BotController@webhook",
                "POST"
            ],
            "/telegram/tick": "Telegram\\Plugin\\BotController@tick",
            "/telegram/api/shifts": "Telegram\\Plugin\\ApiController@shifts",
            "/telegram/api/entries": "Telegram\\Plugin\\ApiController@entries",
            "/telegram/api/checkins": "Telegram\\Plugin\\ApiController@checkins",
            "/telegram/api/people": "Telegram\\Plugin\\ApiController@people",
            "/telegram/api/log": "Telegram\\Plugin\\ApiController@log",
            "/telegram/api/{resource:.+}": [
                "Telegram\\Plugin\\ApiController@options",
                "OPTIONS"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Telegram\\Plugin\\": "src/"
        }
    }
}
