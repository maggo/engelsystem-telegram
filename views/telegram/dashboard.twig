{% extends 'layouts/app.twig' %}

{% block title %}{{ __('telegram.dashboard.title') }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-3 gap-2">
            <h1 class="mb-0">{{ block('title') }}</h1>
            <span class="text-muted small">
                {{ now.format('D, M j H:i') }} · refreshes every minute ·
                <a href="{{ url('/admin/telegram') }}">{{ __('telegram.admin.title') }}</a>
            </span>
        </div>

        {# Open slots #}
        <h2 class="h4">Open slots today and tomorrow</h2>
        {% if gaps is empty %}
            <p class="text-success mb-5">No open slots today or tomorrow.</p>
        {% else %}
            <p>
                <b>{{ gaps|reduce((sum, gap) => sum + gap.needed - gap.filled, 0) }}</b> people missing
                in {{ gaps|length }} slots · <span class="text-danger">red</span>: started,
                <span class="text-warning">yellow</span>: starts within 3 hours · standby isn't counted
            </p>
            <div class="table-responsive mb-5">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Shift</th><th>Area</th><th class="text-end">Filled</th><th class="text-end">Missing</th></tr>
                    </thead>
                    <tbody>
                        {% for gap in gaps %}
                            <tr>
                                <td{% if gap.urgency %} style="box-shadow: inset 4px 0 var(--bs-{{ gap.urgency }})"{% endif %}>
                                    <a href="{{ url('/shifts', {'action': 'view', 'shift_id': gap.shift.id}) }}">
                                        {{ gap.shift.start.format('D H:i') }}–{{ gap.shift.end.format('H:i') }}
                                    </a>
                                    <span class="small text-muted">{{ gap.shift.title }}</span>
                                </td>
                                <td>{{ gap.angel_type.name }}</td>
                                <td class="text-end">{{ gap.filled }}/{{ gap.needed }}</td>
                                <td class="text-end fw-bold {{ gap.urgency ? 'text-' ~ gap.urgency }}">{{ gap.needed - gap.filled }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# Check-ins #}
        {% set total = checkins.total %}
        <h2 class="h4">Checked in today</h2>
        {% if not checkins.areas %}
            <p class="mb-5">No shifts today.</p>
        {% else %}
            <p>
                <b>{{ total.checked_in }}</b> of {{ total.people }} with a shift today checked in ·
                <b>{{ total.people - total.checked_in }}</b> not yet{% if total.without_shift %} ·
                {{ total.without_shift }} checked in without a shift today{% endif %}
            </p>
            <div class="table-responsive mb-2">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Area</th><th class="text-end">On shift today</th><th class="text-end">Checked in</th><th class="text-end">Missing</th></tr>
                    </thead>
                    <tbody>
                        {% for area in checkins.areas %}
                            <tr>
                                <td>{{ area.name }}</td>
                                <td class="text-end">{{ area.people }}</td>
                                <td class="text-end">{{ area.checked_in }}</td>
                                <td class="text-end {{ area.missing|length ? 'text-danger fw-bold' : 'text-success' }}">{{ area.missing|length }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% for area in checkins.areas|filter(area => area.missing|length) %}
                <details class="mb-2">
                    <summary>{{ area.name }}: {{ area.missing|length }} not checked in</summary>
                    <table class="table table-sm align-middle mt-2">
                        <tbody>
                            {% for person in area.missing %}
                                <tr>
                                    <td>
                                        {{ person.user.displayName }}{% if person.lead %} <span class="badge bg-info">lead</span>{% endif %}
                                        <br><span class="small text-muted">
                                            first shift
                                            <a href="{{ url('/shifts', {'action': 'view', 'shift_id': person.shift.id}) }}">{{ person.shift.start.format('H:i') }}</a>
                                            {{ person.shift.title }}
                                        </span>
                                    </td>
                                    <td class="small">
                                        {{ person.handle ? '@' ~ person.handle : person.user.name }} ·
                                        <a href="{{ url('/users', {'action': 'view', 'user_id': person.user.id}) }}">edit in Engelsystem</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </details>
            {% endfor %}
            <p class="small text-muted mb-5">
                Check-in means they scanned today's QR code at the check-in desk. The lead's roll call
                says who is actually at the shift.
            </p>
        {% endif %}

        {# Onboarding #}
        {% set total = onboarding.total %}
        <h2 class="h4">Onboarding</h2>
        <p>
            <b>{{ total.onboarded }}</b> of {{ total.people }} onboarded (arrived) ·
            <b>{{ total.connected }}</b> connected to the bot ·
            <b>{{ total.people - total.onboarded }}</b> not onboarded yet
        </p>
        <div class="table-responsive mb-2">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Area</th><th class="text-end">People</th><th class="text-end">Connected</th><th class="text-end">Onboarded</th><th class="text-end">Missing</th></tr>
                </thead>
                <tbody>
                    {% for area in onboarding.areas %}
                        <tr>
                            <td>{{ area.name }}</td>
                            <td class="text-end">{{ area.people }}</td>
                            <td class="text-end">{{ area.connected }}</td>
                            <td class="text-end">{{ area.onboarded }}</td>
                            <td class="text-end {{ area.missing|length ? 'text-danger fw-bold' : 'text-success' }}">{{ area.missing|length }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% for area in onboarding.areas|filter(area => area.missing|length) %}
            <details class="mb-2">
                <summary>{{ area.name }}: {{ area.missing|length }} not onboarded</summary>
                <table class="table table-sm align-middle mt-2">
                    <tbody>
                        {% for person in area.missing %}
                            <tr>
                                <td>
                                    {{ person.user.displayName }}{% if person.lead %} <span class="badge bg-info">lead</span>{% endif %}
                                    <br><span class="small text-muted">{{ person.connected ? 'connected to the bot' : 'not connected' }}</span>
                                </td>
                                <td class="small">
                                    {{ person.handle ? '@' ~ person.handle : person.user.name }} ·
                                    <a href="{{ url('/users', {'action': 'view', 'user_id': person.user.id}) }}">edit in Engelsystem</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </details>
        {% endfor %}
        <p class="small text-muted mb-5">
            Wrong handle, or the wrong person connected? Use <a href="{{ url('/admin/telegram') }}">{{ __('telegram.admin.unlink.title') }}</a>.
            No phone or no Telegram? Mark them as arrived on the <a href="{{ url('/admin-arrive') }}">Arrived angels</a> page.
        </p>

        <h2 class="h4">Everything else is in Engelsystem</h2>
        <ul class="mb-5">
            <li><a href="{{ url('/user-shifts') }}">Shifts</a>: staffing, and open slots after tomorrow</li>
            <li><a href="{{ url('/admin-free') }}">Free angels</a>: who is available for a replacement</li>
            <li><a href="{{ url('/admin-active') }}">Goodie list</a>: goodie score (no-shows count against it)</li>
            <li><a href="{{ url('/admin-arrive') }}">Arrived angels</a>: onboarding by hand</li>
            <li><a href="{{ url('/admin/logs', {'search': log_prefix|trim}) }}">Log</a>: everything the bot did</li>
        </ul>
    </div>

    <script src="{{ url('/admin/telegram/dashboard.js') }}"></script>
{% endblock %}
