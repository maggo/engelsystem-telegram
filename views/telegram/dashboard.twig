{% extends 'layouts/app.twig' %}

{% block title %}{{ __('telegram.dashboard.title') }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-3 gap-2">
            <h1 class="mb-0">{{ block('title') }}</h1>
            <span class="text-muted small">
                {{ now.format('D, M j H:i') }} · refreshes every minute ·
                <a href="{{ url('/admin/telegram/live') }}">{{ __('telegram.live.title') }}</a> ·
                <a href="{{ url('/admin/telegram') }}">{{ __('telegram.admin.title') }}</a>
            </span>
        </div>

        {# Shifts: open slots and check-ins #}
        <h2 class="h4">Shifts today and tomorrow</h2>
        <p>
            <b>{{ shifts|filter(row => not row.over)|reduce((sum, row) => sum + row.open, 0) }}</b> open slots in shifts not over yet
            <br><span class="small text-muted">
                Every shift today and tomorrow · leads aren't counted ·
                <span class="text-danger">red</span>: started, <span class="text-warning">yellow</span>: starts within 3 hours ·
                standby isn't counted as open
            </span>
        </p>
        {% if shifts is empty %}
            <p class="text-muted mb-5">No shifts today or tomorrow.</p>
        {% else %}
            <div class="table-responsive mb-5">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Shift</th><th>Area</th><th class="text-end">Filled</th><th class="text-end">Open</th><th class="text-end">Checked in</th></tr>
                    </thead>
                    <tbody>
                        {% for row in shifts %}
                            <tr{% if row.over %} class="text-muted"{% endif %}>
                                <td{% if row.urgency %} style="box-shadow: inset 4px 0 var(--bs-{{ row.urgency }})"{% endif %}>
                                    <a href="{{ url('/shifts', {'action': 'view', 'shift_id': row.shift.id}) }}">
                                        {{ row.shift.start.format('D H:i') }}–{{ row.shift.end.format('H:i') }}
                                    </a>
                                    <span class="small text-muted">{{ row.shift.title }}</span>
                                    {% if row.over %}<span class="badge bg-secondary">over</span>{% endif %}
                                </td>
                                <td>{{ row.angel_type.name }}</td>
                                <td class="text-end">{{ row.filled }}{% if row.needed %}/{{ row.needed }}{% endif %}</td>
                                <td class="text-end fw-bold {{ row.open and row.urgency ? 'text-' ~ row.urgency }}">{{ row.open ?: '' }}</td>
                                <td class="text-end {{ row.missing ? 'text-danger fw-bold' }}">
                                    {{ row.today ? row.checked_in ~ '/' ~ row.filled : '' }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# Check-ins of a day, per area and half day #}
        {% set day = checkins.day.toDateString() %}
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h2 class="h4">Check-ins {{ checkins.day.format('D M j') }}</h2>
            {% if checkins.days|length > 1 %}
                <span class="small">
                    {% for value, label in checkins.days %}
                        {% if value == day %}<b>{{ label }}</b>{% else %}<a href="{{ url('/admin/telegram/dashboard', {'day': value}) }}">{{ label }}</a>{% endif %}
                        {{- not loop.last ? ' ·' }}
                    {% endfor %}
                </span>
            {% endif %}
        </div>
        {% set total = checkins.total %}
        <p>
            <b>{{ total.total.checked_in }}</b> of {{ total.total.people }} volunteers with a shift checked in ·
            <b>{{ total.total.people - total.total.checked_in }}</b> not checked in{% if checkins.without_shift %} ·
            {{ checkins.without_shift }} checked in without a shift that day{% endif %}
            <br><span class="small text-muted">
                Checked in means they scanned the day's QR code at the check-in desk, or an admin checked them in ("by hand", no time) · leads and no-shows aren't counted
            </span>
        </p>
        {% if checkins.areas is empty %}
            <p class="text-muted mb-5">No volunteers on shifts that day.</p>
        {% else %}
            <div class="table-responsive mb-2">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Area</th><th class="text-end">AM</th><th class="text-end">PM</th><th class="text-end">Total</th></tr>
                    </thead>
                    <tbody>
                        {% for area in checkins.areas|merge([total|merge({'name': 'All areas', 'total_row': true})]) %}
                            <tr{% if area.total_row is defined %} class="fw-bold"{% endif %}>
                                <td>{{ area.name }}</td>
                                {% for half in ['AM', 'PM', 'total'] %}
                                    {% set count = area[half] %}
                                    <td class="text-end {{ count.people and count.checked_in < count.people ? 'text-danger' }}">
                                        {{ count.people ? count.checked_in ~ '/' ~ count.people : '' }}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% for area in checkins.areas|filter(area => area.in is not empty) %}
                <details class="mb-2">
                    <summary>{{ area.name }}: {{ area.total.checked_in }} checked in</summary>
                    <ul class="list-unstyled small mt-2 mb-3">
                        {% for half, people in area.in %}
                            <li{% if not loop.last %} class="mb-2"{% endif %}>
                                <b>{{ half }}</b> ({{ people|length }})
                                {% for user in people %}
                                    {%- set time = checkins.times.get(user.id) %}
                                    <br><a href="{{ url('/users', {'action': 'view', 'user_id': user.id}) }}">{{ user.displayName }}</a> <span class="text-muted">{{ time ? time.format('H:i') : 'by hand' }}</span>
                                {% endfor %}
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            {% endfor %}

            <h3 class="h5 mt-4">Not checked in ({{ checkins.missing|length }})</h3>
            {% if checkins.missing is empty %}
                <p class="text-success mb-5">Every volunteer on a shift checked in.</p>
            {% else %}
                <div class="table-responsive mb-2">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>Volunteer</th><th>Telegram</th><th>Shift</th><th></th></tr>
                        </thead>
                        <tbody>
                            {% for person in checkins.missing %}
                                <tr>
                                    <td>
                                        <a href="{{ url('/users', {'action': 'view', 'user_id': person.user.id}) }}">{{ person.user.displayName }}</a>
                                        {%- if person.here %} <span class="small text-success">(here per roll call)</span>{% endif %}
                                    </td>
                                    <td class="small">{{ person.handle ? '@' ~ person.handle : '' }}</td>
                                    <td class="small">{{ person.shifts|join(', ') }}</td>
                                    <td class="small text-end">
                                        <a href="{{ url('/admin/telegram/checkins', {'user': person.user.id, 'day': day}) }}#find">check in by hand</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mb-5">
                    The lead's roll call says who is actually at the shift.
                    Can't scan? <a href="{{ url('/admin/telegram/checkins') }}">{{ __('telegram.checkins.title') }}</a> checks people in by hand.
                </p>
            {% endif %}
        {% endif %}

        {# Onboarding #}
        {% set total = onboarding.total %}
        <h2 class="h4">Onboarding</h2>
        <p>
            <b>{{ total.onboarded }}</b> of {{ total.people }} volunteers onboarded (arrived) ·
            <b>{{ total.connected }}</b> connected to the bot ·
            <b>{{ total.people - total.onboarded }}</b> not onboarded yet
            <br><span class="small text-muted">Leads aren't counted</span>
        </p>
        <div class="table-responsive mb-2">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Area</th><th class="text-end">People</th><th class="text-end">Connected</th><th class="text-end">Onboarded</th><th class="text-end">Missing</th></tr>
                </thead>
                <tbody>
                    {% for area in onboarding.areas %}
                        <tr>
                            <td>{{ area.name }}</td>
                            <td class="text-end">{{ area.people }}</td>
                            <td class="text-end">{{ area.connected }}</td>
                            <td class="text-end">{{ area.onboarded }}</td>
                            <td class="text-end {{ area.missing|length ? 'text-danger fw-bold' : 'text-success' }}">{{ area.missing|length }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% for area in onboarding.areas|filter(area => area.missing|length) %}
            <details class="mb-2">
                <summary>{{ area.name }}: {{ area.missing|length }} not onboarded</summary>
                <table class="table table-sm align-middle mt-2">
                    <tbody>
                        {% for person in area.missing %}
                            <tr>
                                <td>
                                    {{ person.user.displayName }}
                                    <br><span class="small text-muted">{{ person.connected ? 'connected to the bot' : 'not connected' }}</span>
                                </td>
                                <td class="small">
                                    {{ person.handle ? '@' ~ person.handle : person.user.name }} ·
                                    <a href="{{ url('/users', {'action': 'view', 'user_id': person.user.id}) }}">edit in Engelsystem</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </details>
        {% endfor %}
        <p class="small text-muted mb-5">
            Wrong handle, or the wrong person connected? Use <a href="{{ url('/admin/telegram') }}">{{ __('telegram.admin.unlink.title') }}</a>.
            No phone or no Telegram? Mark them as arrived on the <a href="{{ url('/admin-arrive') }}">Arrived angels</a> page.
        </p>

        <h2 class="h4">Everything else is in Engelsystem</h2>
        <ul class="mb-5">
            <li><a href="{{ url('/user-shifts') }}">Shifts</a>: staffing, and open slots after tomorrow</li>
            <li><a href="{{ url('/admin-free') }}">Free angels</a>: who is available for a replacement</li>
            <li><a href="{{ url('/admin-active') }}">Goodie list</a>: goodie score (no-shows count against it)</li>
            <li><a href="{{ url('/admin-arrive') }}">Arrived angels</a>: onboarding by hand</li>
            <li><a href="{{ url('/admin/logs', {'search': log_prefix|trim}) }}">Log</a>: everything the bot did</li>
        </ul>
    </div>

    <script src="{{ url('/admin/telegram/dashboard.js') }}"></script>
{% endblock %}
